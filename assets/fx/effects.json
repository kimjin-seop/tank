{
  "version": 1,
  "units": {
    "length": "game px (engine logical px). r = engine blast radius after Scale option",
    "time": "seconds",
    "angle": "deg, 0=+x, 90=up",
    "speed": "game px/s",
    "gravity": "game px/s^2 (+ = down)",
    "size": "radius in game px",
    "colors": "over-life gradient, evenly spaced",
    "blend": "lighter = additive, normal = source-over",
    "scaleWithR": "value * (r/20) when true; speeds use sqrt(r/20)",
    "soft": "soft=true: draw as radial gradient (center alpha -> 0 at edge) instead of solid disc"
  },
